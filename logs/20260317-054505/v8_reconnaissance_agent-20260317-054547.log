[91m│                                                                              │[0m
[91m│ # Enable global allocation site tracking.                                    │[0m
[91m│ v8_allocation_site_tracking = true                                           │[0m
[91m│                                                                              │[0m
[91m│ # TODO(cbruni, v8:12302): Remove once API is migrated                        │[0m
