[91m│ v8_enable_pointer_compression_8gb = ""                                       │[0m
[91m│                                                                              │[0m
[91m│ # Compile V8 using zlib as dependency.                                       │[0m
[91m│ # Sets -DV8_USE_ZLIB                                                         │[0m
[91m│ v8_use_zlib = true                                                           │[0m
[91m│                                                                              │[0m
[91m│ # Make ValueDeserializer crash if the data to deserialize is invalid.        │[0m
[91m│ v8_value_deserializer_hard_fail = false                                      │[0m
[91m│                                                                              │[0m
