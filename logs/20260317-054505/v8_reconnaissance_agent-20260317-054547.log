[91m│ bazel.                                                                       │[0m
[91m│ #                                                                            │[0m
[91m│ # Naming conventions: Keep switch names short and remove unnecessary         │[0m
[91m│ # qualifiers. Drop v8_enable_, v8_, is_ where possible.                      │[0m
[91m│ # Keep only qualifiers that disambiguate the switches from other things.     │[0m
[91m│ # Examples: has_turbofan disambiguates from the turbofan runtime variant,    │[0m
[91m│ # is_android disambiguates from the android keyword in status files,         │[0m
[91m│ # v8_cfi disambiguates from the global cfi flag.                             │[0m
[91m│ args = [                                                                     │[0m
[91m│ rebase_path("$root_out_dir/v8_build_config.json", root_build_dir),           │[0m
[91m│ "arch=\"$arch\"",                                                            │[0m
[91m│ "asan=$is_asan",                                                             │[0m
[91m│ "atomic_object_field_writes=$v8_enable_atomic_object_field_writes",          │[0m
[91m│ "cet_shadow_stack=$v8_enable_cet_shadow_stack",                              │[0m
[91m│ "cfi=$is_cfi",                                                               │[0m
[91m│ "clang=$is_clang",                                                           │[0m
[91m│ "clang_coverage=$use_clang_coverage",                                        │[0m
[91m│ "code_comments=$v8_code_comments",                                           │[0m
[91m│ "component_build=$is_component_build",                                       │[0m
[91m│ "concurrent_marking=$v8_enable_concurrent_marking",                          │[0m
[91m│ "current_cpu=\"$current_cpu\"",                                              │[0m
[91m│ "dcheck_always_on=$v8_dcheck_always_on",                                     │[0m
[91m│ "debug_code=$v8_enable_debug_code",                                          │[0m
[91m│ "DEBUG_defined=$is_DEBUG_defined",                                           │[0m
[91m│ "debugging_features=$v8_enable_debugging_features",                          │[0m
[91m│ "dict_property_const_tracking=$v8_dict_property_const_tracking",             │[0m
[91m│ "direct_handle=$v8_enable_direct_handle",                                    │[0m
[91m│ "disassembler=$v8_enable_disassembler",                                      │[0m
[91m│ "dumpling=$v8_dumpling",                                                     │[0m
[91m│ "full_debug=$is_full_debug",                                                 │[0m
[91m│ "gdbjit=$v8_enable_gdbjit",                                                  │[0m
[91m│ "has_jitless=$v8_jitless",                                                   │[0m
[91m│ "has_maglev=$v8_enable_maglev",                                              │[0m
[91m│ "has_turbofan=$v8_enable_turbofan",                                          │[0m
[91m│ "has_webassembly=$v8_enable_webassembly",                                    │[0m
