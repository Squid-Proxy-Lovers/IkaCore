[91m│ v8_enable_trace_ignition = false                                             │[0m
[91m│ v8_enable_trace_baseline_exec = false                                        │[0m
[91m│                                                                              │[0m
[91m│ # Sets -DV8_TRACE_FEEDBACK_UPDATES.                                          │[0m
[91m│ v8_enable_trace_feedback_updates = false                                     │[0m
[91m│                                                                              │[0m
[91m│ # Sets -DV8_ATOMIC_OBJECT_FIELD_WRITES and turns all field write operations  │[0m
[91m│ # into relaxed atomic operations.                                            │[0m
[91m│ v8_enable_atomic_object_field_writes = ""                                    │[0m
[91m│                                                                              │[0m
[91m│ # Controls the default value of v8_enable_concurrent_marking_state. See the  │[0m
[91m│ # default setting code below.                                                │[0m
[91m│ v8_enable_concurrent_marking = true                                          │[0m
[91m│                                                                              │[0m
[91m│ # Sets -DV8_IGNITION_DISPATCH_COUNTING.                                      │[0m
[91m│ # Enables counting frequencies of bytecode dispatches. After building in     │[0m
[91m│ this                                                                         │[0m
[91m│ # configuration, subsequent runs of d8 can output frequencies for each pair  │[0m
[91m│ # of (current, next) bytecode instructions executed if you specify           │[0m
[91m│ # --trace-ignition-dispatches-output-file, or can generate a JS object with  │[0m
[91m│ # those frequencies if you run with --expose-ignition-statistics and call    │[0m
[91m│ the                                                                          │[0m
[91m│ # extension function getIgnitionDispatchCounters().                          │[0m
[91m│ v8_enable_ignition_dispatch_counting = false                                 │[0m
[91m│                                                                              │[0m
[91m│ # Enable frame elision for builtins.                                         │[0m
[91m│ v8_enable_builtins_frame_elision = true                                      │[0m
[91m│                                                                              │[0m
[91m│ # Runs mksnapshot with --turbo-profiling. After building in this             │[0m
[91m│ # configuration, any subsequent run of d8 will output information about      │[0m
[91m│ usage                                                                        │[0m
[91m│ # of basic blocks in builtins.                                               │[0m
[91m│ v8_enable_builtins_profiling = false                                         │[0m
[91m│                                                                              │[0m
[91m│ # Runs mksnapshot with --turbo-profiling-verbose. After building in this     │[0m
[91m│ # configuration, any subsequent run of d8 will output information about      │[0m
[91m│ usage                                                                        │[0m
[91m│ # of basic blocks in builtins, including the schedule and disassembly of all │[0m
[91m│ # used builtins.                                                             │[0m
[91m│ v8_enable_builtins_profiling_verbose = false                                 │[0m
[91m│                                                                              │[0m
[91m│ # This build flag is used to input a builtin pgo file containing raw         │[0m
[91m│ # execution counts (as opposed to branch hints), which are embedded into     │[0m
[91m│ # the `--trace-turbo` .json file from `mksnapshot`.                          │[0m
[91m│ v8_log_builtins_block_count_input = ""                                       │[0m
[91m│                                                                              │[0m
[91m│ # This build flag is used to control whether reorder builtins according to   │[0m
[91m│ # the call graph with C3 algorithm based builtin PGO profiling.              │[0m
[91m│ v8_enable_builtins_reordering = true                                         │[0m
[91m│                                                                              │[0m
[91m│ # Provides the given V8 log file as an input to mksnapshot, where it can be  │[0m
[91m│ # used for profile-guided optimization of builtins.                          │[0m
[91m│ #                                                                            │[0m
[91m│ # To do profile-guided optimizations of builtins:                            │[0m
[91m│ # 1. Build with v8_enable_builtins_profiling = true                          │[0m
[91m│ # 2. Run your chosen workload with the --turbo-profiling-output flag.        │[0m
[91m│ # For Chrome, the invocation might look like this:                           │[0m
[91m│ # chrome --no-sandbox --disable-extensions                                   │[0m
[91m│ # --js-flags="--turbo-profiling-output=v8.builtins.pgo"                      │[0m
[91m│ # "http://localhost/test-suite"                                              │[0m
[91m│ # 3. Run tools/builtins-pgo/get_hints.py to produce the branch hints,        │[0m
[91m│ # selecting min_count and threshold_ratio as you wish.                       │[0m
[91m│ # 4. Optionally repeat steps 2-3 for additional workloads, and use           │[0m
[91m│ # tools/builtins-pgo/combine_hints.py to combine the hints produced in       │[0m
[91m│ # step 3 into a single file.                                                 │[0m
[91m│ # 5. Build again with v8_builtins_profiling_log_file set to the file created │[0m
[91m│ # in step 3 or 4.                                                            │[0m
[91m│ v8_builtins_profiling_log_file = "default"                                   │[0m
[91m│                                                                              │[0m
[91m│ # Enable gearbox (instruction set extension) for builtins, the gearbox       │[0m
[91m│ # feature only supports x64 arch yet.                                        │[0m
[91m│ # Sets -DV8_BUILTINS_GEARBOX                                                 │[0m
[91m│ v8_enable_builtins_gearbox = false                                           │[0m
[91m│                                                                              │[0m
[91m│ # Enables various testing features.                                          │[0m
[91m│ v8_enable_test_features = ""                                                 │[0m
[91m│                                                                              │[0m
[91m│ # Enable short builtins call instruction sequences by un-embedding builtins. │[0m
[91m│ # Sets -DV8_SHORT_BUILTIN_CALLS                                              │[0m
[91m│ v8_enable_short_builtin_calls = ""                                           │[0m
[91m│                                                                              │[0m
[91m│ # Enable support for external code range relative to the pointer compression │[0m
[91m│ # cage.                                                                      │[0m
[91m│ # Sets -DV8_EXTERNAL_CODE_SPACE                                              │[0m
[91m│ v8_enable_external_code_space = ""                                           │[0m
[91m│                                                                              │[0m
[91m│ # With post mortem support enabled, metadata is embedded into libv8 that     │[0m
[91m│ # describes various parameters of the VM for use by debuggers. See           │[0m
[91m│ # tools/gen-postmortem-metadata.py for details.                              │[0m
[91m│ v8_postmortem_support = false                                                │[0m
[91m│                                                                              │[0m
[91m│ # Use Siphash as added protection against hash flooding attacks.             │[0m
[91m│ v8_use_siphash = false                                                       │[0m
[91m│                                                                              │[0m
[91m│ # Switches off inlining in V8.                                               │[0m
[91m│ v8_no_inline = false                                                         │[0m
[91m│                                                                              │[0m
[91m│ # Override OS page size when generating snapshot                             │[0m
[91m│ v8_os_page_size = "0"                                                        │[0m
[91m│                                                                              │[0m
[91m│ # Similar to vfp but on MIPS.                                                │[0m
[91m│ v8_can_use_fpu_instructions = true                                           │[0m
[91m│                                                                              │[0m
[91m│ # Similar to the ARM hard float ABI but on MIPS.                             │[0m
[91m│ v8_use_mips_abi_hardfloat = true                                             │[0m
[91m│                                                                              │[0m
[91m│ # Controls the threshold for on-heap/off-heap Typed Arrays.                  │[0m
[91m│ v8_typed_array_max_size_in_heap = 64                                         │[0m
[91m│                                                                              │[0m
[91m│ # Sets -DENABLE_GDB_JIT_INTERFACE.                                           │[0m
[91m│ v8_enable_gdbjit =                                                           │[0m
[91m│ is_debug && (((v8_current_cpu == "x86" || v8_current_cpu == "x64") &&        │[0m
[91m│ (is_linux || is_chromeos || is_mac)) ||                                      │[0m
[91m│ (v8_current_cpu == "ppc64" && (is_linux || is_chromeos)))                    │[0m
[91m│                                                                              │[0m
[91m│ # Check that each header can be included in isolation (requires also         │[0m
[91m│ # setting the "check_v8_header_includes" gclient variable to run a           │[0m
[91m│ # specific hook).                                                            │[0m
[91m│ v8_check_header_includes = false                                             │[0m
[91m│                                                                              │[0m
[91m│ # Enable lazy source positions by default.                                   │[0m
[91m│ v8_enable_lazy_source_positions = true                                       │[0m
[91m│                                                                              │[0m
[91m│ # Disable write barriers when GCs are non-incremental and                    │[0m
[91m│ # heap has single generation.                                                │[0m
[91m│ v8_disable_write_barriers = false                                            │[0m
[91m│                                                                              │[0m
[91m│ # Ensure that write barriers are always used.                                │[0m
[91m│ # Useful for debugging purposes.                                             │[0m
[91m│ v8_enable_unconditional_write_barriers = false                               │[0m
[91m│                                                                              │[0m
[91m│ # Redirect allocation in young generation so that there will be              │[0m
[91m│ # only one single generation.                                                │[0m
[91m│ v8_enable_single_generation = ""                                             │[0m
[91m│                                                                              │[0m
[91m│ # Use token threaded dispatch for the regular expression interpreter.        │[0m
[91m│ # Use switch-based dispatch if this is false                                 │[0m
[91m│ v8_enable_regexp_interpreter_threaded_dispatch = true                        │[0m
[91m│                                                                              │[0m
[91m│ # Enforce equality of builtins hashes from compatible architectures.         │[0m
[91m│ v8_verify_builtins_compatibility = false                                     │[0m
[91m│                                                                              │[0m
[91m│ # Check mksnapshot determinism by running it multiple times.                 │[0m
[91m│ v8_verify_deterministic_mksnapshot = false                                   │[0m
[91m│                                                                              │[0m
[91m│ # Enable additional targets necessary for verification of torque             │[0m
[91m│ # file generation                                                            │[0m
[91m│ v8_verify_torque_generation_invariance = false                               │[0m
[91m│                                                                              │[0m
[91m│ # Generate comments describing the Torque intermediate representation.       │[0m
[91m│ v8_annotate_torque_ir = false                                                │[0m
[91m│                                                                              │[0m
[91m│ # Enable snapshot compression (enabled by default for desktop) devices.      │[0m
[91m│ v8_enable_snapshot_compression =                                             │[0m
[91m│ target_os == "android" || target_os == "chromeos" ||                         │[0m
[91m│ target_os == "fuchsia"                                                       │[0m
[91m│                                                                              │[0m
[91m│ # Enable control-flow integrity features, such as pointer authentication for │[0m
[91m│ # ARM64. Enable it by default for simulator builds and when native code      │[0m
[91m│ # supports it as well. On Mac, control-flow integrity does not work so we    │[0m
[91m│ # avoid enabling it when using the simulator.                                │[0m
[91m│ v8_control_flow_integrity = v8_current_cpu == "arm64" &&                     │[0m
[91m│ ((v8_target_is_simulator && target_os != "mac") ||                           │[0m
[91m│ arm_control_flow_integrity != "none")                                        │[0m
[91m│                                                                              │[0m
[91m│ # Enable heap reservation of size 4GB. Only possible for 64bit archs.        │[0m
[91m│ cppgc_enable_caged_heap =                                                    │[0m
[91m│ v8_current_cpu == "x64" || v8_current_cpu == "arm64" ||                      │[0m
[91m│ v8_current_cpu == "loong64" || v8_current_cpu == "riscv64"                   │[0m
[91m│                                                                              │[0m
[91m│ # Enables additional heap verification phases and checks.                    │[0m
[91m│ cppgc_enable_verify_heap = ""                                                │[0m
[91m│                                                                              │[0m
[91m│ # Enable allocations during prefinalizer invocations.                        │[0m
[91m│ cppgc_allow_allocations_in_prefinalizers = false                             │[0m
[91m│                                                                              │[0m
[91m│ # Enable the V8 sandbox.                                                     │[0m
[91m│ # Sets -DV8_ENABLE_SANDBOX.                                                  │[0m
[91m│ v8_enable_sandbox = ""                                                       │[0m
[91m│                                                                              │[0m
[91m│ # Enable experimental hardware support for the V8 sandbox if available.      │[0m
[91m│ # Sets -DV8_ENABLE_SANDBOX_HARDWARE_SUPPORT                                  │[0m
[91m│ v8_enable_sandbox_hardware_support = false                                   │[0m
[91m│                                                                              │[0m
[91m│ # Enable the memory corruption API. Useful for testing the sandbox.          │[0m
[91m│ # The memory corruption API is only exposed to JavaScript if sandbox testing │[0m
[91m│ # mode is enabled at runtime, for example via --sandbox-fuzzing.             │[0m
[91m│ # WARNING This will enable builtins that (by design) cause memory            │[0m
[91m│ corruption.                                                                  │[0m
[91m│ # Sets -DV8_ENABLE_MEMORY_CORRUPTION_API                                     │[0m
[91m│ v8_enable_memory_corruption_api = false                                      │[0m
[91m│                                                                              │[0m
[91m│ # Experimental feature for collecting per-class zone memory stats.           │[0m
[91m│ # Requires use_rtti = true                                                   │[0m
[91m│ v8_enable_precise_zone_stats = false                                         │[0m
[91m│                                                                              │[0m
[91m│ # Set this if V8 monolithic static library is going to be linked into        │[0m
[91m│ # another shared library.                                                    │[0m
[91m│ v8_monolithic_for_shared_library = false                                     │[0m
[91m│                                                                              │[0m
[91m│ # Experimental feature that uses SwissNameDictionary instead of              │[0m
[91m│ NameDictionary                                                               │[0m
[91m│ # as the backing store for all dictionary mode objects.                      │[0m
[91m│ v8_enable_swiss_name_dictionary = false                                      │[0m
[91m│                                                                              │[0m
[91m│ # If enabled then macro definitions that are used in externally visible      │[0m
