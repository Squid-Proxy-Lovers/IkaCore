[91m│ # This is only used by nodejs.                                               │[0m
[91m│ v8_scriptormodule_legacy_lifetime = false                                    │[0m
[91m│                                                                              │[0m
[91m│ # Enables pointer compression for 8GB heaps.                                 │[0m
