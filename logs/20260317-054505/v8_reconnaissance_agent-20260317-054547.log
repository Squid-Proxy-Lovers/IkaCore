[91m│ v8_generate_external_defines_header = false                                  │[0m
[91m│                                                                              │[0m
[91m│ # Experimental feature for tracking constness of properties in non-global    │[0m
[91m│ # dictionaries. Enabling this also always keeps prototypes in dict mode,     │[0m
[91m│ # meaning that they are not switched to fast mode.                           │[0m
[91m│ # Sets -DV8_DICT_PROPERTY_CONST_TRACKING                                     │[0m
[91m│ v8_dict_property_const_tracking = false                                      │[0m
[91m│                                                                              │[0m
[91m│ # Enable map packing & unpacking (sets -DV8_MAP_PACKING).                    │[0m
[91m│ v8_enable_map_packing = false                                                │[0m
[91m│                                                                              │[0m
[91m│ # Allow for JS promise hooks (instead of just C++).                          │[0m
[91m│ v8_enable_javascript_promise_hooks = false                                   │[0m
[91m│                                                                              │[0m
[91m│ # Allow embedder data to be saved on continuations. Used to support          │[0m
[91m│ # TaskAttribution and `scheduler.yield()`.                                   │[0m
[91m│ # The flag enables disabling the feature, to test this data's overhead.      │[0m
[91m│ v8_enable_continuation_preserved_embedder_data = true                        │[0m
[91m│                                                                              │[0m
[91m│ # Enable allocation folding globally (sets -DV8_ALLOCATION_FOLDING).         │[0m
