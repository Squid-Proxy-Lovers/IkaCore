[91m│ visibility = [ ":*" ] # Only targets in this file can depend on this.        │[0m
[91m│ if (is_win) {                                                                │[0m
[91m│ ldflags = [ "/OPT:NOICF" ] # link.exe, but also lld-link.exe.                │[0m
[91m│ } else if (is_apple && !use_lld) {                                           │[0m
[91m│ ldflags = [ "-Wl,-no_deduplicate" ] # ld64.                                  │[0m
[91m│ } else if (use_lld) {                                                        │[0m
[91m│ ldflags = [ "-Wl,--icf=none" ]                                               │[0m
[91m│ }                                                                            │[0m
[91m│ }                                                                            │[0m
[91m│ }                                                                            │[0m
