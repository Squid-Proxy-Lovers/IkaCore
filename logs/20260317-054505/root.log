[91m│ # A simple harness that downloads and runs 'jsfunfuzz' against d8. This    │[0m
[91m│ # takes a long time because it runs many iterations and is intended for    │[0m
[91m│ # automated usage. The package containing 'jsfunfuzz' can be found as an   │[0m
[91m│ # attachment to this bug:                                                  │[0m
[91m│ # https://bugzilla.mozilla.org/show_bug.cgi?id=jsfunfuzz                   │[0m
[91m│                                                                            │[0m
[91m│ JSFUNFUZZ_URL="https://bugzilla.mozilla.org/attachment.cgi?id=310631"      │[0m
[91m│ JSFUNFUZZ_MD5="d0e497201c5cd7bffbb1cdc1574f4e32"                           │[0m
[91m│                                                                            │[0m
[91m│ v8_root=$(readlink -f $(dirname $BASH_SOURCE)/../)                         │[0m
[91m│ jsfunfuzz_dir="$v8_root/tools/jsfunfuzz"                                   │[0m
[91m│                                                                            │[0m
[91m│ if [ -n "$1" ]; then                                                       │[0m
[91m│ d8="${v8_root}/$1"                                                         │[0m
[91m│ else                                                                       │[0m
[91m│ d8="${v8_root}/d8"                                                         │[0m
[91m│ fi                                                                         │[0m
[91m│                                                                            │[0m
[91m│ if [ ! -f "$d8" ]; then                                                    │[0m
[91m│ echo "Failed to find d8 binary: $d8"                                       │[0m
[91m│ exit 1                                                                     │[0m
[91m│ fi                                                                         │[0m
[91m│                                                                            │[0m
[91m│ # Deprecated download method. A prepatched archive is downloaded as a hook │[0m
[91m│ # if jsfunfuzz=1 is specified as a gyp flag. Requires google.com           │[0m
[91m│ authentication                                                             │[0m
[91m│ # for google storage.                                                      │[0m
[91m│ if [ "$3" == "--download" ]; then                                          │[0m
[91m│                                                                            │[0m
[91m│ jsfunfuzz_file="$v8_root/tools/jsfunfuzz.zip"                              │[0m
[91m│ if [ ! -f "$jsfunfuzz_file" ]; then                                        │[0m
[91m│ echo "Downloading $jsfunfuzz_file ..."                                     │[0m
[91m│ wget -q -O "$jsfunfuzz_file" $JSFUNFUZZ_URL || exit 1                      │[0m
[91m│ fi                                                                         │[0m
[91m│                                                                            │[0m
[91m│ jsfunfuzz_sum=$(md5sum "$jsfunfuzz_file" | awk '{ print $1 }')             │[0m
[91m│ if [ $jsfunfuzz_sum != $JSFUNFUZZ_MD5 ]; then                              │[0m
[91m│ echo "Failed to verify checksum!"                                          │[0m
[91m│ exit 1                                                                     │[0m
[91m│ fi                                                                         │[0m
[91m│                                                                            │[0m
[91m│ if [ ! -d "$jsfunfuzz_dir" ]; then                                         │[0m
[91m│ echo "Unpacking into $jsfunfuzz_dir ..."                                   │[0m
[91m│ unzip "$jsfunfuzz_file" -d "$jsfunfuzz_dir" || exit 1                      │[0m
[91m│ echo "Patching runner ..."                                                 │[0m
[91m│ cat << EOF | patch -s -p0 -d "$v8_root"                                    │[0m
[91m│ --- tools/jsfunfuzz/jsfunfuzz/multi_timed_run.py~                          │[0m
[91m│ +++ tools/jsfunfuzz/jsfunfuzz/multi_timed_run.py                           │[0m
[91m│ @@ -125,7 +125,7 @@                                                        │[0m
[91m│                                                                            │[0m
[91m│ def many_timed_runs():                                                     │[0m
[91m│ iteration = 0                                                              │[0m
[91m│ - while True:                                                              │[0m
[91m│ + while iteration < 100:                                                   │[0m
[91m│ iteration += 1                                                             │[0m
[91m│ logfilename = "w%d" % iteration                                            │[0m
[91m│ one_timed_run(logfilename)                                                 │[0m
[91m│ EOF                                                                        │[0m
[91m│ fi                                                                         │[0m
[91m│                                                                            │[0m
[91m│ fi                                                                         │[0m
[91m│                                                                            │[0m
[91m│ flags='--expose-gc --verify-gc'                                            │[0m
[91m│ python -u "$jsfunfuzz_dir/jsfunfuzz/multi_timed_run.py" 300 \              │[0m
[91m│ "$d8" $flags "$jsfunfuzz_dir/jsfunfuzz/jsfunfuzz.js"                       │[0m
[91m│ exit_code=$(cat w* | grep " looking good" -c)                              │[0m
[91m│ exit_code=$((100-exit_code))                                               │[0m
[91m│                                                                            │[0m
[91m│ if [ -n "$2" ]; then                                                       │[0m
[91m│ archive="$2"                                                               │[0m
[91m│ else                                                                       │[0m
[91m│ archive=fuzz-results-$(date +%Y%m%d%H%M%S).tar.bz2                         │[0m
[91m│ fi                                                                         │[0m
