[91m│                                                                              │[0m
[91m│ config("strict_warnings") {                                                  │[0m
[91m│ cflags = []                                                                  │[0m
[91m│ if (is_clang) {                                                              │[0m
[91m│ if (v8_current_cpu == "x64" || v8_current_cpu == "arm64" ||                  │[0m
[91m│ v8_current_cpu == "mips64el" || v8_current_cpu == "riscv64") {               │[0m
[91m│ cflags += [ "-Wshorten-64-to-32" ]                                           │[0m
[91m│ }                                                                            │[0m
[91m│ cflags += [ "-Wmissing-field-initializers" ]                                 │[0m
[91m│ if (v8_current_cpu != "ppc64" && v8_current_cpu != "s390x") {                │[0m
[91m│ cflags += [ "-Wunnecessary-virtual-specifier" ]                              │[0m
[91m│ }                                                                            │[0m
[91m│ }                                                                            │[0m
[91m│ }                                                                            │[0m
[91m│                                                                              │[0m
[91m│ # For code that is hot during mksnapshot. In fast-mksnapshot builds, we      │[0m
[91m│ # optimize some files even in debug builds to speed up mksnapshot times.     │[0m
[91m│ config("always_turbofanimize") {                                             │[0m
[91m│ configs = [ ":internal_config" ]                                             │[0m
[91m│                                                                              │[0m
[91m│ # TODO(crbug.com/621335) Rework this so that we don't have the confusion     │[0m
[91m│ # between "optimize_speed" and "optimize_max".                               │[0m
[91m│ if (((is_posix && !is_android) || is_fuchsia || is_win) && !using_sanitizer) │[0m
[91m│ {                                                                            │[0m
[91m│ configs += [ "//build/config/compiler:optimize_speed" ]                      │[0m
[91m│ } else {                                                                     │[0m
[91m│ configs += [ "//build/config/compiler:optimize_max" ]                        │[0m
[91m│ }                                                                            │[0m
[91m│ }                                                                            │[0m
[91m│                                                                              │[0m
[91m│ # Sanitizer defines. V8 will inherit a default `-fsanitize=array-bounds`     │[0m
[91m│ # from Chromium's `//build/config/`, which prevents clean usage of           │[0m
[91m│ # `__has_feature(undefined_behavior_sanitizer)` in the short term,           │[0m
[91m│ # until something like `--lie-about-ubsan-enablement=array-bounds`           │[0m
[91m│ # can be implemented.                                                        │[0m
[91m│ #                                                                            │[0m
[91m│ # This config provides a clear signal of "are we sanitizing" tied to         │[0m
[91m│ # GN configuration.                                                          │[0m
[91m│ #                                                                            │[0m
[91m│ # See also: https://crbug.com/386992829                                      │[0m
[91m│ config("sanitizer_defines") {                                                │[0m
[91m│ defines = []                                                                 │[0m
[91m│ if (is_asan) {                                                               │[0m
[91m│ defines += [ "V8_USE_ADDRESS_SANITIZER" ]                                    │[0m
[91m│ }                                                                            │[0m
[91m│ if (is_hwasan) {                                                             │[0m
[91m│ defines += [ "V8_USE_HWADDRESS_SANITIZER" ]                                  │[0m
[91m│ }                                                                            │[0m
[91m│ if (is_msan) {                                                               │[0m
[91m│ defines += [ "V8_USE_MEMORY_SANITIZER" ]                                     │[0m
[91m│ }                                                                            │[0m
[91m│ if (is_ubsan) {                                                              │[0m
[91m│ defines += [ "V8_USE_UNDEFINED_BEHAVIOR_SANITIZER" ]                         │[0m
[91m│ }                                                                            │[0m
[91m│ }                                                                            │[0m
