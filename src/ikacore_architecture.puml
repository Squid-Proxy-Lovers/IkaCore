@startuml IkaCore Architecture and Execution Flow

skinparam class {
    BackgroundColor<<core>> #E1F5FF
    BackgroundColor<<orchestrator>> #FFF4E1
    BackgroundColor<<stage>> #E0F0FF
    BackgroundColor<<tool>> #FFE0E0
    BackgroundColor<<memory>> #E8F5E9
    BackgroundColor<<base>> #E8F5E9
    BackgroundColor<<model>> #F3E5F5
    BackgroundColor<<provider>> #F3E5F5
    BackgroundColor<<persistence>> #FFFFFF
    BackgroundColor<<rag>> #FFFFFF
    BackgroundColor<<data>> #F5F5F5
    BackgroundColor<<executor>> #FFF4E1
}

package "IkaCore Framework" {
    
    ' ============================================
    ' Core Agent System
    ' ============================================
    class IkaBaseAgent <<core>> {
        +name: str
        +description: str
        +prompt: str
        +tools: List[IkaTools]
        +Stages: List[IkaStage]
        +subagents: List[IkaBaseAgent]
        +next_agent: IkaBaseAgent
        +maxsteps: int
        +memory: bool
        +checkpoint: bool
        +message_history: Dict
        +short_term_memory: STMemory
        +long_term_memory: LTMemory
        --
        +execution(checkpoint_uid): Dict[str, str]
        +run_simple(): tuple[str, str]
        +excute_stage(stage_index, remaining_steps): tuple
        +build_tool_executors(): Dict[str, Callable]
        +get_barebone(): BareBoneModel
        +parse_control_calls(): tuple
        +_save_to_short_term(): str
        +_save_to_long_term(): str
        +_search_short_term(): dict
        +_search_long_term(): dict
        +_save_stage_checkpoint(): str
        +_save_agent_checkpoint(): str
        +load_checkpoint(uid): dict
    }
    
    ' ============================================
    ' Workflow System
    ' ============================================
    class IkaWorkflow <<orchestrator>> {
        +name: str
        +description: str
        +nodes: List[WorkflowNode]
        +edges: List[WorkflowEdge]
        +start_node: str
        +async_executor: AsyncWorkflowExecutor
        --
        +run(initial_context, use_async): Dict[str, WorkflowResult]
        +run_async(initial_context): Dict[str, WorkflowResult]
        -_run_node(): WorkflowResult
        -_run_node_async(): WorkflowResult
        -_prepare_context(): str
        -_apply_stage_wiring(): void
        -_build_dependency_graph(): void
    }
    
    class WorkflowNode <<data>> {
        +name: str
        +agent: IkaBaseAgent
        +stage_wiring: Dict[int, Dict]
        +instances: int
        +instance_inputs: List[str]
    }
    
    class WorkflowEdge <<data>> {
        +source: str
        +target: str
        +edge_type: str
        +stage_index: int
    }
    
    class AsyncWorkflowExecutor <<executor>> {
        +max_workers: int
        +executor: ThreadPoolExecutor
        --
        +schedule_node(): Future
        +wait_for_completion(): List[Any]
        +drain(): void
    }
    
    ' ============================================
    ' Stage System
    ' ============================================
    class IkaStage <<stage>> {
        +name: str
        +prompt: str
        +tools: List[IkaTools]
        +stage_max_step: int
        +subagents: List[IkaBaseAgent]
        +allowed_back_to: List[int]
        +hitl: bool
        +memory_access: Dict[str, bool]
        +long_term_filter: Callable
    }
    
    ' ============================================
    ' Tool System
    ' ============================================
    class IkaTools <<tool>> {
        +id: str
        +name: str
        +description: str
        +parameters: dict
        +limit_calls: int
        +required: bool
        +execute_function: Callable
        +parallel: bool
        --
        +execute(parameters): str
    }
    
    class AgentTool <<tool>> {
        +id: str
        +name: str
        +description: str
        +args: ToolArgs
        +required: bool
        +parallel: bool
    }
    
    ' ============================================
    ' Memory System
    ' ============================================
    class Memory <<base>> {
        +storage: Any
        +agent: str
        +task: str
        --
        +save(value, metadata): void
        +search(query, limit, score_threshold): List[Any]
        +reset(): void
    }
    
    class STMemory <<memory>> {
        +agent: str
        +storage: StorageInterface
        --
        +save(data, metadata): void
        +search(query, limit, score_threshold): List[Any]
    }
    
    class LTMemory <<memory>> {
        +agent: str
        +storage: StorageInterface
        --
        +save(item): void
        +search(query, limit, score_threshold): List[Any]
    }
    
    class STMemItem <<data>> {
        +data: str
        +agent: str
        +metadata: Dict
    }
    
    class LTMemItem <<data>> {
        +agent: str
        +task: str
        +expected_output: str
        +datetime: str
        +quality: float
        +metadata: Dict
    }
    
    ' ============================================
    ' Model System
    ' ============================================
    class BareBoneModel <<model>> {
        +model_id: str
        +api_key: str
        +api_url: str
        +system_prompt: str
        +content_prompt: str
        +max_tokens: int
        +temperature: float
        +agent_tools: List[AgentTool]
        +parallel_tool_calls: bool
        +agent_name: str
        +agent_hierarchy: List[str]
    }
    
    interface ModelProvider <<interface>> {
        +chat(): Dict
        +fill_payload(): Dict
    }
    
    class OpenAIProvider <<provider>> {
        +chat(): Dict
    }
    
    class ClaudeProvider <<provider>> {
        +chat(): Dict
    }
    
    class DeepSeekProvider <<provider>> {
        +chat(): Dict
    }
    
    class GoogleProvider <<provider>> {
        +chat(): Dict
    }
    
    ' ============================================
    ' Checkpoint System
    ' ============================================
    class CheckpointStore <<persistence>> {
        +db_path: str
        --
        +save_checkpoint(scope, payload, uid): str
        +load_checkpoint(uid): dict
        +delete_checkpoint(uid): void
    }
    
    ' ============================================
    ' RAG System
    ' ============================================
    abstract class IkaRAGSource <<rag>> {
        +name: str
        +description: str
        +type: str
        --
        +search(query): List[str]
        +get_document(document_id): str
    }
    
    ' ============================================
    ' Relationships
    ' ============================================
    IkaBaseAgent "1" *-- "0..*" IkaStage : contains
    IkaBaseAgent "1" *-- "0..*" IkaTools : uses
    IkaBaseAgent "1" *-- "0..*" IkaBaseAgent : subagents
    IkaBaseAgent "1" --> "0..1" IkaBaseAgent : next_agent
    IkaBaseAgent "1" --> "0..1" STMemory : has
    IkaBaseAgent "1" --> "0..1" LTMemory : has
    IkaBaseAgent "1" --> "0..1" CheckpointStore : uses
    IkaBaseAgent "1" --> "1" BareBoneModel : creates
    
    IkaWorkflow "1" *-- "1..*" WorkflowNode : contains
    IkaWorkflow "1" *-- "0..*" WorkflowEdge : contains
    IkaWorkflow "1" --> "1" AsyncWorkflowExecutor : uses
    WorkflowNode "1" --> "1" IkaBaseAgent : wraps
    
    IkaStage "1" *-- "0..*" IkaTools : contains
    IkaStage "1" *-- "0..*" IkaBaseAgent : subagents
    
    IkaTools ..> AgentTool : converts to
    IkaBaseAgent ..> AgentTool : builds
    
    Memory <|-- STMemory
    Memory <|-- LTMemory
    STMemory "1" *-- "0..*" STMemItem : stores
    LTMemory "1" *-- "0..*" LTMemItem : stores
    
    BareBoneModel ..> ModelProvider : uses
    ModelProvider <|.. OpenAIProvider
    ModelProvider <|.. ClaudeProvider
    ModelProvider <|.. DeepSeekProvider
    ModelProvider <|.. GoogleProvider
    
    IkaBaseAgent ..> IkaRAGSource : uses
    
    note right of IkaBaseAgent
        **Execution Modes:**
        1. Simple: run_simple()
        2. Staged: execution() with Stages
        3. Workflow: via IkaWorkflow
        4. Subagent: via subagents list
    end note
    
    note right of IkaWorkflow
        **Workflow Execution:**
        - Sequential: run()
        - Parallel: run_async()
        - Supports child edges (sub-workflows)
        - Supports next edges (linear flow)
    end note
    
    note right of IkaStage
        **Stage Features:**
        - Stage-specific tools
        - Stage-specific memory access
        - HITL (Human-in-the-loop)
        - Stage navigation (forward/backward)
    end note
    
@enduml
